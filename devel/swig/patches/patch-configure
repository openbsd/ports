From dda786f0fae6f01de1b2fc54aae57bf5a2afb7ee Mon Sep 17 00:00:00 2001
From: William S Fulton <wsf@fultondesigns.co.uk>
Date: Mon, 23 Feb 2026 08:11:01 +0000
Subject: [PATCH] Correct LDSHARED for OpenBSD

Index: configure
--- configure.orig
+++ configure
@@ -6619,7 +6619,8 @@ then
 	*-*-linux*) LDSHARED="\$(CC) -shared";;
 	*-*-dgux*) LDSHARED="ld -G";;
 	*-*-freebsd3*) LDSHARED="\$(CC) -shared";;
-	*-*-freebsd* | *-*-openbsd*) LDSHARED="ld -Bshareable";;
+	*-*-freebsd*) LDSHARED="ld -Bshareable";;
+	*-*-openbsd*) LDSHARED="\$(CC) -shared";;
 	*-*-netbsd*)
 		if [ "`\$(CC) -dM -E - </dev/null | grep __ELF__`" != "" ]
 		then
