+# Code generated by Crubit is only formatted when using Crubit from
+# //third_party/rust-toolchain.  Formatting only makes the generated code easier
+# to read, and the formatting tools may not be available when using a
+# system-provided Crubit.  Therefore `rustfmt_exe_path` and
+# `clang_format_exe_path` may be undefined.
+if (rust_crubit_root == "//third_party/rust-toolchain") {
+  rustfmt_exe_path = "//third_party/rust-toolchain/bin/rustfmt"
+  if (host_os == "win") {
+    rustfmt_exe_path += ".exe"
+  }
+
+  # TODO(lukasza): Make this also work on other host platforms.  (Possibly
+  # hoisting this Crubit-agnostic functionality into some other, reusable
+  # location elsewhere.)
+  if (host_os == "linux") {
+    clang_format_exe_path = "//buildtools/linux64-format/clang-format"
+  } else if (host_os == "win") {
+    clang_format_exe_path = "//buildtools/win-format/clang-format.exe"
+  }
