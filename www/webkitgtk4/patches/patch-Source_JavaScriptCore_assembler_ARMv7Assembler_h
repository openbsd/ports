CPU(ARM_TRADITIONAL) is never set on armv7 (Thumb2 is available) and is the
only ARM flavour MacroAssembler.h still supports, so key on the OS instead.

Index: Source/JavaScriptCore/assembler/ARMv7Assembler.h
--- Source/JavaScriptCore/assembler/ARMv7Assembler.h.orig
+++ Source/JavaScriptCore/assembler/ARMv7Assembler.h
@@ -2886,6 +2886,8 @@ class ARMv7Assembler { (public)
             linuxPageFlush(current, current + page);
 
         linuxPageFlush(current, end);
+#elif OS(FREEBSD) || OS(NETBSD) || OS(OPENBSD)
+        __clear_cache(code, reinterpret_cast<char*>(code) + size);
 #else
 #error "The cacheFlush support is missing on this platform."
 #endif
