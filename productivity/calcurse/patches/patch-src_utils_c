fixes for systems where time_t is not long (i.e. 32-bit machines, where
it is long long).

Index: src/utils.c
--- src/utils.c.orig
+++ src/utils.c
@@ -358,9 +358,9 @@ int is_all_digit(const char *string)
 }
 
 /* Given an item date expressed in seconds, return its start time in seconds. */
-long get_item_time(time_t date)
+time_t get_item_time(time_t date)
 {
-	return (long)(get_item_hour(date) * HOURINSEC +
+	return (time_t)(get_item_hour(date) * HOURINSEC +
 		      get_item_min(date) * MININSEC);
 }
 
@@ -619,7 +619,7 @@ time_t get_sec_date(struct date date)
 	return date2sec(date, 0, 0);
 }
 
-long min2sec(unsigned minutes)
+time_t min2sec(unsigned minutes)
 {
 	return minutes * MININSEC;
 }
