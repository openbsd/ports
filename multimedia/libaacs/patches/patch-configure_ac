- Add OpenBSD MMC device backend using SCIOCCOMMAND

Index: configure.ac
--- configure.ac.orig
+++ configure.ac
@@ -54,6 +54,10 @@ case "${host_os}" in
     LDFLAGS="${LDFLAGS} -lobjc -Wl,-framework,IOKit,-framework,Cocoa,-framework,DiskArbitration"
     SET_FEATURES="${SET_FEATURES} -D_DARWIN_C_SOURCE"
     ;;
+  *openbsd*)
+    SYS=openbsd
+    SET_FEATURES="${SET_FEATURES} -D_BSD_SOURCE"
+    ;;
   *)
     SYS="${host_os}"
     ;;
@@ -61,6 +65,7 @@ esac
 
 AM_CONDITIONAL(HAVE_WIN32,   test "${SYS}" = "mingw32")
 AM_CONDITIONAL(HAVE_DARWIN,  test "${SYS}" = "darwin")
+AM_CONDITIONAL(HAVE_OPENBSD, test "${SYS}" = "openbsd")
 
 dnl configure options
 AC_ARG_ENABLE([werror],
