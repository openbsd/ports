+/*
+ * MIT-SHM 1.2 (fd passing) is needed, and fd passing only works over
+ * a unix domain socket.
+ */
+static bool shm_fd_usable(Display *dpy)
+{
+    struct sockaddr_storage ss;
+    socklen_t sslen = sizeof(ss);
+    int major, minor;
+    Bool pixmaps;
+
+    if (!XShmQueryVersion(dpy, &major, &minor, &pixmaps))
+        return false;
+    if (major < 1 || (major == 1 && minor < 2))
+        return false;
+    if (getsockname(ConnectionNumber(dpy), (struct sockaddr *)&ss,
+                    &sslen) == -1)
+        return false;
+    return ss.ss_family == AF_UNIX;
+}
+
+/*
+ * Create a POSIX shm segment of len bytes, map it and pass it to the
+ * X server.  xcb owns the fd once it has been handed to
+ * xcb_shm_attach_fd_checked() and closes it after sending it, so it
+ * must not be closed here after that point.
+ */
+static bool shm_fd_attach(Display *dpy, XShmSegmentInfo *si, size_t len)
+{
+    char name[] = "/tmp/mpv-xv-XXXXXXXXXX";
+    xcb_connection_t *c = XGetXCBConnection(dpy);
+    xcb_generic_error_t *err;
+    void *addr;
+    int fd;
+
+    *si = (XShmSegmentInfo){0};
+    si->shmid = -1;
+
+    fd = shm_mkstemp(name);
+    if (fd == -1)
+        return false;
+    shm_unlink(name);
+    if (ftruncate(fd, len) == -1) {
+        close(fd);
+        return false;
+    }
+    addr = mmap(NULL, len, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (addr == MAP_FAILED) {
+        close(fd);
+        return false;
+    }
+
+    si->shmseg = xcb_generate_id(c);
+    si->readOnly = False;
+    err = xcb_request_check(c, xcb_shm_attach_fd_checked(c, si->shmseg,
+                                                         fd, si->readOnly));
+    if (err) {
+        free(err);
+        munmap(addr, len);
+        *si = (XShmSegmentInfo){0};
+        return false;
+    }
+    si->shmaddr = addr;
+    return true;
+}
+
+static void shm_fd_detach(Display *dpy, XShmSegmentInfo *si, size_t len)
+{
+    XShmDetach(dpy, si);
+    munmap(si->shmaddr, len);
+    *si = (XShmSegmentInfo){0};
+}
