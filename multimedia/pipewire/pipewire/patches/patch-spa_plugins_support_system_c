 static int impl_eventfd_write(void *object, int fd, uint64_t count)
 {
+#ifdef __OpenBSD__
+	if (send(fd, &count, sizeof(uint64_t), MSG_DONTWAIT) == sizeof(uint64_t))
+		return 0;
+	if (errno == EAGAIN || errno == EWOULDBLOCK || errno == ENOBUFS)
+		return 0; /* receive queue full: a wakeup is already pending */
+	if (errno != ENOTSOCK)
+		return -errno;
+	/* semaphore eventfd from epoll-shim, fall through */
+#endif
 	if (write(fd, &count, sizeof(uint64_t)) != sizeof(uint64_t))
 		return -errno;
 	return 0;
@@ -213,6 +293,21 @@ static int impl_eventfd_write(void *object, int fd, ui
 
 static int impl_eventfd_read(void *object, int fd, uint64_t *count)
 {
+#ifdef __OpenBSD__
+	uint64_t v, total;
+
+	if (recv(fd, &v, sizeof(v), 0) == sizeof(v)) {
+		total = v;
+		/* drain coalesced wakeups, mimicking the eventfd counter */
+		while (recv(fd, &v, sizeof(v), MSG_DONTWAIT) == sizeof(v))
+			total += v;
+		*count = total;
+		return 0;
+	}
+	if (errno != ENOTSOCK)
+		return -errno;
+	/* semaphore eventfd from epoll-shim, fall through */
+#endif
 	if (read(fd, count, sizeof(uint64_t)) != sizeof(uint64_t))
 		return -errno;
 	return 0;
