Raw SPA audio streams carry interleaved samples but the layout field
of the GStreamer caps is ignored, so planar (non-interleaved) buffers
negotiated by upstream elements get pushed through as if interleaved,
garbling the audio. Refuse such caps so that negotiation converges on
interleaved instead. To be sent upstream.

Index: src/gst/gstpipewireformat.c
--- src/gst/gstpipewireformat.c.orig
+++ src/gst/gstpipewireformat.c
@@ -693,6 +693,25 @@ handle_audio_fields (ConvertData *d)
   struct spa_pod_frame f, f0;
   int i = 0;
 
+  /* Raw SPA audio streams carry interleaved samples and the layout
+   * field is not translated below, so refuse caps that cannot be
+   * produced interleaved instead of silently misinterpreting planar
+   * buffers. */
+  if (strcmp (d->type->name, "audio/x-raw") == 0) {
+    value = gst_structure_get_value (d->cs, "layout");
+    if (value) {
+      const char *v;
+      gboolean interleaved = FALSE;
+      for (i = 0; (v = get_nth_string (value, i)); i++) {
+        if (spa_streq (v, "interleaved"))
+          interleaved = TRUE;
+      }
+      if (!interleaved)
+        return;
+      i = 0;
+    }
+  }
+
   spa_pod_dynamic_builder_init (&b, NULL, 0, 1024);
 
   spa_pod_builder_push_object (&b.b, &f0, SPA_TYPE_OBJECT_Format,
