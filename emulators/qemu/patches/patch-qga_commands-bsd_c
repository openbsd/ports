+GuestLogicalProcessorList *qmp_guest_get_vcpus(Error **errp)
+{
+    GuestLogicalProcessorList *head, **tail;
+    long ncpu;
+    int64_t id;
+
+    head = NULL;
+    tail = &head;
+
+    ncpu = sysconf(_SC_NPROCESSORS_ONLN);
+    if (ncpu < 1) {
+        error_setg(errp, "failed to query number of online CPUs");
+        return NULL;
+    }
+
+    for (id = 0; id < ncpu; id++) {
+        GuestLogicalProcessor *vcpu;
+
+        vcpu = g_malloc0(sizeof *vcpu);
+        vcpu->logical_id = id;
+        vcpu->online = true;
+        vcpu->has_can_offline = true;  /* can_offline stays false */
+
+        QAPI_LIST_APPEND(tail, vcpu);
+    }
+
+    return head;
+}
