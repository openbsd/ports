+GuestUserList *qmp_guest_get_users(Error **errp)
+{
+    GHashTable *cache;
+    GuestUserList *head = NULL, **tail = &head;
+    struct utmp ut;
+    FILE *fp = NULL;
+
+    fp = fopen(_PATH_UTMP, "r");
+    if (!fp) {
+        error_setg_errno(errp, errno, "failed to open %s", _PATH_UTMP);
+        return NULL;
+    }
+
+    cache = g_hash_table_new(g_str_hash, g_str_equal);
+
+    while (fread(&ut, sizeof(ut), 1, fp) == 1) {
+        g_autofree char *name = NULL;
+        GuestUser *user;
+        double login_time;
+
+        /* logout(3) clears ut_name; skip empty slots like who(1) does */
+        if (ut.ut_name[0] == '\0' || ut.ut_line[0] == '\0') {
+            continue;
+        }
+
+        /* ut_name is not NUL-terminated if it fills UT_NAMESIZE */
+        name = g_strndup(ut.ut_name, sizeof(ut.ut_name));
+        login_time = (double)ut.ut_time;
+
+        user = g_hash_table_lookup(cache, name);
+        if (user) {
+            /* We're ensuring the earliest login time to be sent */
+            if (login_time < user->login_time) {
+                user->login_time = login_time;
+            }
+            continue;
+        }
+
+        user = g_new0(GuestUser, 1);
+        user->user = g_steal_pointer(&name);
+        user->login_time = login_time;
+
+        g_hash_table_insert(cache, user->user, user);
+        QAPI_LIST_APPEND(tail, user);
+    }
+
+    fclose(fp);
+    g_hash_table_destroy(cache);
+    return head;
+}
