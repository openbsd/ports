Own org.gnome.keyring.SystemPrompter as soon as the component is constructed
instead of waiting for enable().
Without pam_gnome_keyring unlocking the login keyring, goa-daemon asks for a
secret early enough that the name is still unowned; dbus then activates
gcr-prompter, which serves the prompt as a plain GTK dialog (instead of
gnome-shell dialog) and keeps the name until its idle timeout. The class already
guards real dialogs behind _enabled (KeyringDummyDialog otherwise), so
registration and enablement can be separated safely.

Index: js/ui/components/keyring.js
--- js/ui/components/keyring.js.orig
+++ js/ui/components/keyring.js
@@ -213,15 +213,22 @@ class KeyringPrompter extends Gcr.SystemPrompter {
         this._registered = false;
         this._enabled = false;
         this._currentPrompt = null;
+
+        this._register();
     }
 
+    _register() {
+        if (this._registered)
+            return;
+
+        this.register(Gio.DBus.session);
+        this._dbusId = Gio.DBus.session.own_name('org.gnome.keyring.SystemPrompter',
+            Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT, null, null);
+        this._registered = true;
+    }
+
     enable() {
-        if (!this._registered) {
-            this.register(Gio.DBus.session);
-            this._dbusId = Gio.DBus.session.own_name('org.gnome.keyring.SystemPrompter',
-                Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT, null, null);
-            this._registered = true;
-        }
+        this._register();
         this._enabled = true;
     }
 
