No dma-buf sync-file export ioctl outside Linux; skip get_sync_file() and
poll the dma-buf fds directly. Keep the sync fd ownership tracking so the
linux-drm-syncobj path does not close an fd that is still being watched.

Index: src/wayland/meta-wayland-dma-buf.c
--- src/wayland/meta-wayland-dma-buf.c.orig
+++ src/wayland/meta-wayland-dma-buf.c
@@ -39,7 +39,9 @@
 
 #include <drm_fourcc.h>
 #include <glib/gstdio.h>
+#ifdef __linux__
 #include <linux/dma-buf.h>
+#endif
 #include <sys/ioctl.h>
 #include <sys/stat.h>
 #include <sys/types.h>
@@ -1065,6 +1067,7 @@ create_source (MetaWaylandBuffer               *buffer
   return source;
 }
 
+#ifdef __linux__
 static int
 get_sync_file (int dma_buf_fd)
 {
@@ -1082,6 +1085,7 @@ get_sync_file (int dma_buf_fd)
 
   return -1;
 }
+#endif
 
 /**
  * meta_wayland_dma_buf_create_source:
@@ -1122,9 +1126,11 @@ meta_wayland_dma_buf_create_source (MetaWaylandBuffer 
       if (!source)
         source = create_source (buffer, dispatch, user_data);
 
+#ifdef __linux__
       source->owned_sync_fd[i] = get_sync_file (fd);
       if (source->owned_sync_fd[i] >= 0)
         fd = source->owned_sync_fd[i];
+#endif
 
       source->fd_tags[i] = g_source_add_unix_fd (&source->base, fd, G_IO_IN);
     }
