@@ -350,6 +356,62 @@ ErrorHandler( Display *dpy, XErrorEvent *event )
 
     Display 		*dpy;
 
+#if defined(__OpenBSD__)
+static char	*consolePath = NULL;
+
+/*
+ * xenodm(1) SetConsolePath(): console device of the X server, for
+ * login_wscons.
+ */
+static void
+SetConsolePath(Display *dpy)
+{
+	Atom prop;
+	Atom actualtype;
+	int actualformat;
+	unsigned long nitems;
+	unsigned long bytes_after;
+	unsigned char *buf;
+
+	if (dpy == NULL)
+		return;
+
+	prop = XInternAtom(dpy, "Xorg_Console", True);
+	if (prop == None) {
+		LogError((unsigned char *)"no Xorg_Console atom\n");
+		return;
+	}
+	if (XGetWindowProperty(dpy, DefaultRootWindow(dpy), prop, 0,
+		TTY_NAME_MAX << 2,
+		False, AnyPropertyType, &actualtype, &actualformat,
+		&nitems, &bytes_after, &buf)) {
+		LogError((unsigned char *)"no Xorg_Console property\n");
+		return;
+	}
+	if (actualtype != XA_STRING) {
+		LogError((unsigned char *)"type %lx in Xorg_Console property!\n",
+		    actualtype);
+		XFree(buf);
+		return;
+	}
+	if (actualformat != 8) {
+		LogError((unsigned char *)"format %d in Xorg_Console property!\n",
+		    actualformat);
+		XFree(buf);
+		return;
+	}
+	if (strncmp((char *)buf, _PATH_DEV, strlen(_PATH_DEV)) != 0) {
+		LogError((unsigned char *)"bad Xorg_Console property: %s\n", buf);
+		XFree(buf);
+		return;
+	}
+	free(consolePath);
+	consolePath = strdup((char *)buf + strlen(_PATH_DEV));
+	Debug("consolePath: %s\n", consolePath ? consolePath : "(null)");
+	XFree(buf);
+}
+#endif
