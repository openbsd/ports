+#if defined(__OpenBSD__)
+/* compare with the saved state of /etc/localtime in case /etc has a change */
+static gboolean
+system_timezone_localtime_update (SystemTimezonePrivate *priv)
+{
+        struct stat  st;
+        gboolean     exists;
+        char        *target = NULL;
+        gboolean     changed;
+
+        exists = g_lstat (ETC_LOCALTIME, &st) == 0;
+        if (exists && S_ISLNK (st.st_mode))
+                target = g_file_read_link (ETC_LOCALTIME, NULL);
+
+        changed = exists != priv->localtime_exists ||
+                  g_strcmp0 (target, priv->localtime_target) != 0;
+        if (exists && !changed)
+                changed = st.st_ino != priv->localtime_ino ||
+                          st.st_mtim.tv_sec != priv->localtime_mtime.tv_sec ||
+                          st.st_mtim.tv_nsec != priv->localtime_mtime.tv_nsec;
+
+        priv->localtime_exists = exists;
+        g_free (priv->localtime_target);
+        priv->localtime_target = target;
+        if (exists) {
+                priv->localtime_ino = st.st_ino;
+                priv->localtime_mtime = st.st_mtim;
+        }
+
+        return changed;
+}
+
+static gboolean
+system_timezone_etc_changed (gint         fd,
+                             GIOCondition condition,
+                             gpointer     user_data)
+{
+        SystemTimezone        *systz = SYSTEM_TIMEZONE (user_data);
+        SystemTimezonePrivate *priv;
+        struct kevent          ev;
+        struct timespec        ts = { 0, 0 };
+
+        priv = system_timezone_get_instance_private (systz);
+
+        while (kevent (fd, NULL, 0, &ev, 1, &ts) > 0)
+                ;
+
+        if (system_timezone_localtime_update (priv))
+                system_timezone_monitor_changed (NULL, NULL, NULL,
+                                                 G_FILE_MONITOR_EVENT_CHANGED,
+                                                 systz);
+
+        return G_SOURCE_CONTINUE;
+}
+
+static void
+system_timezone_etc_watch_start (SystemTimezone *systz)
+{
+        SystemTimezonePrivate *priv;
+        struct kevent          ev;
+
+        priv = system_timezone_get_instance_private (systz);
+
+        priv->etc_fd = open (ETC_DIR, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+        if (priv->etc_fd == -1)
+                return;
+
+        priv->etc_kq = kqueue ();
+        if (priv->etc_kq == -1) {
+                system_timezone_etc_watch_stop (systz);
+                return;
+        }
+
+        EV_SET (&ev, priv->etc_fd, EVFILT_VNODE, EV_ADD | EV_CLEAR,
+                NOTE_WRITE | NOTE_EXTEND, 0, NULL);
+        if (kevent (priv->etc_kq, &ev, 1, NULL, 0, NULL) == -1) {
+                system_timezone_etc_watch_stop (systz);
+                return;
+        }
+
+        system_timezone_localtime_update (priv);
+
+        priv->etc_watch_id = g_unix_fd_add (priv->etc_kq, G_IO_IN,
+                                            system_timezone_etc_changed,
+                                            systz);
+}
+
+static void
+system_timezone_etc_watch_stop (SystemTimezone *systz)
+{
+        SystemTimezonePrivate *priv;
+
+        priv = system_timezone_get_instance_private (systz);
+
+        if (priv->etc_watch_id != 0) {
+                g_source_remove (priv->etc_watch_id);
+                priv->etc_watch_id = 0;
+        }
+        if (priv->etc_kq != -1) {
+                close (priv->etc_kq);
+                priv->etc_kq = -1;
+        }
+        if (priv->etc_fd != -1) {
+                close (priv->etc_fd);
+                priv->etc_fd = -1;
+        }
+        g_clear_pointer (&priv->localtime_target, g_free);
+}
+#endif
 
