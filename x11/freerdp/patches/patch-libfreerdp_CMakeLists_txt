Recognize the bundled FindFFmpeg's uppercase AVCODEC result for MJPEG.

Drop useless confusing chunk. Upstream's merging process seems very
confusing and often results in commits that seem to be (and in some
cases definitely are) bad.

Index: libfreerdp/CMakeLists.txt
--- libfreerdp/CMakeLists.txt.orig
+++ libfreerdp/CMakeLists.txt
@@ -176,7 +176,7 @@ if(WITH_SWSCALE)
     # AVUTIL is needed for av_image_* functions, AVCODEC is optional (for MJPEG in video.c)
     find_package(FFmpeg REQUIRED COMPONENTS SWSCALE AVUTIL)
     find_package(FFmpeg COMPONENTS AVCODEC)
-    if(FFmpeg_avcodec_FOUND)
+    if(FFmpeg_AVCODEC_FOUND OR FFmpeg_avcodec_FOUND)
       message(STATUS "FFmpeg AVCODEC found - MJPEG support available in video codec wrappers")
       set(WITH_FFMPEG ON)
     else()
@@ -189,22 +189,6 @@ if(WITH_CAIRO)
   find_package(Cairo REQUIRED)
   freerdp_pc_add_requires_private("cairo")
 endif(WITH_CAIRO)
-
-# Prefer SWScale over Cairo, both at the same time are not possible.
-if(WITH_SWSCALE)
-  if(NOT WITH_SWSCALE_LOADING)
-    include_directories(SYSTEM ${SWSCALE_INCLUDE_DIRS} ${AVUTIL_INCLUDE_DIRS})
-    freerdp_library_add(${SWSCALE_LIBRARIES} ${AVUTIL_LIBRARIES})
-    if(FFmpeg_avcodec_FOUND)
-      include_directories(SYSTEM ${AVCODEC_INCLUDE_DIRS})
-      freerdp_library_add(${AVCODEC_LIBRARIES})
-    endif()
-  endif(NOT WITH_SWSCALE_LOADING)
-endif()
-if(WITH_CAIRO)
-  include_directories(SYSTEM ${CAIRO_INCLUDE_DIR})
-  freerdp_library_add(${CAIRO_LIBRARY})
-endif()
 if(NOT WITH_SWSCALE AND NOT WITH_CAIRO)
   message(WARNING "-DWITH_SWSCALE=OFF and -DWITH_CAIRO=OFF, compiling without image scaling support!")
 endif()
