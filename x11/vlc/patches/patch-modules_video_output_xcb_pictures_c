+#ifdef HAVE_SYS_SHM_H
+/**
+ * Check MIT-SHM 1.2 (fd passing) support. File descriptors can only be
+ * passed over a local (unix domain socket) connection.
+ */
+static bool XCB_shm_fd_Check (xcb_connection_t *conn)
+{
+    union {
+        struct sockaddr sa;
+        struct sockaddr_storage ss;
+    } addr;
+    socklen_t len = sizeof (addr);
+
+    if (getsockname (xcb_get_file_descriptor (conn), &addr.sa, &len) != 0
+     || addr.sa.sa_family != AF_UNIX)
+        return false;
+
+    xcb_shm_query_version_reply_t *r =
+        xcb_shm_query_version_reply (conn, xcb_shm_query_version (conn), NULL);
+    if (r == NULL)
+        return false;
+
+    bool ok = r->major_version > 1
+           || (r->major_version == 1 && r->minor_version >= 2);
+    free (r);
+    return ok;
+}
+
 /**
- * Release picture private data: detach the shared memory segment.
+ * Allocate shared memory from an unlinked file and pass its file
+ * descriptor to the X server (MIT-SHM 1.2).
+ */
+static void *XCB_picture_AllocFd (vout_display_t *vd, size_t size,
+                                  xcb_connection_t *conn,
+                                  xcb_shm_seg_t segment)
+{
+    int fd = vlc_memfd ();
+    if (fd == -1)
+    {
+        msg_Err (vd, "shared memory file error: %s", vlc_strerror_c(errno));
+        return NULL;
+    }
+
+    if (ftruncate (fd, size) != 0)
+    {
+        msg_Err (vd, "shared memory file size error: %s",
+                 vlc_strerror_c(errno));
+        vlc_close (fd);
+        return NULL;
+    }
+
+    void *shm = mmap (NULL, size, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0);
+    if (shm == MAP_FAILED)
+    {
+        msg_Err (vd, "shared memory mapping error: %s",
+                 vlc_strerror_c(errno));
+        vlc_close (fd);
+        return NULL;
+    }
+
+    /* xcb takes ownership of fd and closes it once it has been sent */
+    xcb_void_cookie_t ck = xcb_shm_attach_fd_checked (conn, segment, fd, 1);
+    if (vlc_xcb_error_Check(vd, conn, "shared memory fd server-side error",
+                            ck))
+    {
+        munmap (shm, size);
+        return NULL;
+    }
+    return shm;
+}
+#endif
+
+static void XCB_picture_Free (picture_sys_t *sys, void *pixels)
+{
+#ifdef HAVE_SYS_SHM_H
+    if (sys->size != 0)
+        munmap (pixels, sys->size);
+    else
+#endif
+        shmdt (pixels);
+    free (sys);
+}
+
+/**
