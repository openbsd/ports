- libusb cannot reset a device on OpenBSD; don't fail the probe on that.
- Ignore zero-length interrupt completions (see comment).
- Resubmit the interrupt wait with the interrupt cancellable, so that
  cancel() can still end it.
- Without the reset the sensor may not be ready right after boot: until it
  has reported a finger once, restart verify/identify transparently (see
  comment).

Index: libfprint/drivers/synaptics/synaptics.c
--- libfprint/drivers/synaptics/synaptics.c.orig
+++ libfprint/drivers/synaptics/synaptics.c
@@ -27,6 +27,132 @@
 
 G_DEFINE_TYPE (FpiDeviceSynaptics, fpi_device_synaptics, FP_TYPE_DEVICE)
 
+/*
+ * Without the USB reset done at probe time (unsupported on e.g. OpenBSD), the
+ * sensor may not be usable yet when fprintd starts right after boot: verify
+ * and identify fail with BMKT_GENERAL_ERROR or never report a finger, while
+ * GET_FPS_MODE says idle. An operation started in that state stays broken,
+ * one started once the sensor has settled works.
+ *
+ * So until the sensor has reported a finger once, restart the operation
+ * transparently: after a general error, and whenever no finger was reported
+ * for a while after it asked for one.
+ */
+#define SETTLE_WATCHDOG_MS	3000	/* no finger report: restart */
+#define SETTLE_RETRY_MS		2000	/* general error: retry */
+
+static void verify (FpDevice *device);
+static void identify (FpDevice *device);
+static void cancel (FpDevice *dev);
+
+static gboolean
+settle_guard (FpiDeviceSynaptics *self)
+{
+  return self->reset_unsupported && !self->finger_seen;
+}
+
+static void
+settle_clear (FpiDeviceSynaptics *self)
+{
+  if (self->settle_source)
+    {
+      g_source_destroy (self->settle_source);
+      self->settle_source = NULL;
+    }
+}
+
+static void
+settle_complete (FpDevice *device, GError *error)
+{
+  if (fpi_device_get_current_action (device) == FPI_DEVICE_ACTION_IDENTIFY)
+    fpi_device_identify_complete (device, error);
+  else
+    fpi_device_verify_complete (device, error);
+}
+
+/* Start the current verify/identify again, unless it was cancelled. */
+static void
+settle_restart (FpDevice *device)
+{
+  FpiDeviceAction action = fpi_device_get_current_action (device);
+
+  if (g_cancellable_is_cancelled (fpi_device_get_cancellable (device)))
+    {
+      settle_complete (device, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED,
+                                                    "Operation was cancelled"));
+      return;
+    }
+
+  if (action == FPI_DEVICE_ACTION_IDENTIFY)
+    identify (device);
+  else
+    verify (device);
+}
+
+static void
+settle_retry_cb (FpDevice *device, gpointer user_data)
+{
+  FPI_DEVICE_SYNAPTICS (device)->settle_source = NULL;
+  settle_restart (device);
+}
+
+static void
+settle_watchdog_cb (FpDevice *device, gpointer user_data)
+{
+  FpiDeviceSynaptics *self = FPI_DEVICE_SYNAPTICS (device);
+
+  self->settle_source = NULL;
+
+  /* Only while waiting for a finger that never came */
+  if (!settle_guard (self) || self->finger_on_sensor || self->cmd_suspended ||
+      self->cmd_ssm == NULL ||
+      fpi_ssm_get_cur_state (self->cmd_ssm) != SYNAPTICS_CMD_WAIT_INTERRUPT)
+    return;
+
+  g_message ("No finger reported yet, restarting operation (sensor may not be ready)");
+  self->restarting = TRUE;
+  cancel (device);
+}
+
+static void
+settle_arm_watchdog (FpiDeviceSynaptics *self)
+{
+  settle_clear (self);
+  if (settle_guard (self))
+    self->settle_source = fpi_device_add_timeout (FP_DEVICE (self), SETTLE_WATCHDOG_MS,
+                                                  settle_watchdog_cb, NULL, NULL);
+}
+
+/* General error while unsettled: retry later instead of failing. */
+static gboolean
+settle_retry_on_error (FpiDeviceSynaptics *self, gint result)
+{
+  if (result != BMKT_GENERAL_ERROR || !settle_guard (self))
+    return FALSE;
+
+  g_message ("General error from the sensor, retrying (sensor may not be ready)");
+  settle_clear (self);
+  self->settle_source = fpi_device_add_timeout (FP_DEVICE (self), SETTLE_RETRY_MS,
+                                                settle_retry_cb, NULL, NULL);
+  return TRUE;
+}
+
+/* The cancellation we asked for: restart instead of completing. */
+static gboolean
+settle_restart_on_cancel (FpiDeviceSynaptics *self, GError *error)
+{
+  if (!self->restarting)
+    return FALSE;
+
+  self->restarting = FALSE;
+  if (!g_error_matches (error, G_IO_ERROR, G_IO_ERROR_CANCELLED))
+    return FALSE;
+
+  g_error_free (error);
+  settle_restart (FP_DEVICE (self));
+  return TRUE;
+}
