+        System.out.println("ExtractPrefetch tempOutFile: " + targetPath);
+        try (BufferedWriter writer = Files.newBufferedWriter(Paths.get(tempOutFile),
+                StandardOpenOption.CREATE, StandardOpenOption.APPEND)) {
+
+            System.out.println("ExtractPrefetch writer: " + writer);
+            for (File pfFile : pfFiles) {
+                List<String> commandLine = Arrays.asList(prefetchExePath, "-f", pfFile.getAbsolutePath());
+                System.out.println("ExtractPrefetch parsing: " + pfFile.getAbsolutePath());
+                ProcessBuilder pb = new ProcessBuilder(commandLine);
+                pb.redirectError(ProcessBuilder.Redirect.appendTo(errFilePath.toFile()));
+
+                Process process = pb.start();
+
+                try (BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8))) {
+                    StringBuilder jsonBuffer = new StringBuilder();
+                    String line;
+
+                    while ((line = reader.readLine()) != null) {
+                        if (line.startsWith("******** Converting")) {
+                            System.out.println("ExtractPrefetch dropping **** line: " + line);
+                            continue;
+                        }
+                        jsonBuffer.append(line).append("\n");
+                    }
+
+                    String jsonText = jsonBuffer.toString().trim();
+                    if (!jsonText.isEmpty()) {
+                        com.google.gson.JsonElement parsedElement = com.google.gson.JsonParser.parseString(jsonText);
+                        
+                        // Inject source_file into the JsonObject
+                        if (parsedElement.isJsonObject()) {
+                            com.google.gson.JsonObject jsonObject = parsedElement.getAsJsonObject();
