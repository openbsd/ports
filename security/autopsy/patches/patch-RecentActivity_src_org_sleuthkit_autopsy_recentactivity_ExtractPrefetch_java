+                    }
+                }
+
+                try {
+                    process.waitFor();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    break;
+                }
+                System.out.println("ExtractPrefetch tempOutFile: " + tempOutFile);
+            }
