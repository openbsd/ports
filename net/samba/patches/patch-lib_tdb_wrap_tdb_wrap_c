Silent fallback to fcntl locking when optional TDB mutexes are unavailable.
Taken from https://gitlab.com/samba-team/samba/-/merge_requests/4700

Index: lib/tdb_wrap/tdb_wrap.c
--- lib/tdb_wrap/tdb_wrap.c.orig
+++ lib/tdb_wrap/tdb_wrap.c
@@ -151,8 +151,10 @@ struct tdb_wrap *tdb_wrap_open(TALLOC_CTX *mem_ctx,
 
 		if (tdb_flags & TDB_MUTEX_LOCKING) {
 			if (!tdb_runtime_check_for_robust_mutexes()) {
+#ifdef HAVE_ROBUST_MUTEXES
 				DBG_ERR("mutexes requested but not "
 					"available\n");
+#endif
 				tdb_flags &= ~TDB_MUTEX_LOCKING;
 			}
 		}
