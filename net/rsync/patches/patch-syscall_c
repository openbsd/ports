From ea645201fefbba7f6b6b22b621856dba3c01cdd3 Mon Sep 17 00:00:00 2001
From: Zen Dodd <mail@steadytao.com>
Date: Fri, 6 Nov 2026 20:51:34 +1000
Subject: [PATCH] syscall: skip unsupported symlink chmod (#1148)

Index: syscall.c
--- syscall.c.orig
+++ syscall.c
@@ -1806,6 +1806,8 @@ int do_chmod(const char *path, mode_t mode)
 				code = 1;
 # elif defined AT_FDCWD && defined AT_SYMLINK_NOFOLLOW
 			code = fchmodat(AT_FDCWD, path, mode & CHMOD_BITS, AT_SYMLINK_NOFOLLOW);
+			if (code < 0 && (errno == ENOTSUP || errno == EOPNOTSUPP || errno == ENOSYS))
+				code = 1;
 # else
 			code = 1;
 # endif
