Implement OpenBSD file-to-socket transfers with bounded buffered I/O.
Preserve the input file position and let Chronos retry partial writes.

Index: dist/nimble/vendor/chronos/chronos/sendfile.nim
--- dist/nimble/vendor/chronos/chronos/sendfile.nim.orig
+++ dist/nimble/vendor/chronos/chronos/sendfile.nim
@@ -43,6 +43,33 @@ elif defined(emscripten) or defined(haiku):
   proc sendfile*(outfd, infd: int, offset: int, count: var int): int =
     raiseAssert "sendfile() is not implemented yet"
 
+elif defined(openbsd):
+  import std/posix
+
+  proc sendfile*(outfd, infd: int, offset: int, count: var int): int =
+    let requested = count
+    count = 0
+    if requested < 0 or offset < 0:
+      errno = EINVAL
+      return -1
+    if requested == 0:
+      return 0
+
+    # pread preserves the file position. The caller retries unsent bytes.
+    var buffer: array[16384, byte]
+    let nread = pread(cint(infd), addr buffer[0],
+                      min(requested, buffer.len), Off(offset))
+    if nread < 0:
+      return -1
+    if nread == 0:
+      return 0
+    let written = send(SocketHandle(outfd), addr buffer[0], nread,
+                       MSG_NOSIGNAL)
+    if written < 0:
+      return -1
+    count = written
+    0
+
