# Install 2D fonts only. The 3D fonts are just dummy files;
# the real 3D fonts are located here:
# https://github.com/googlefonts/noto-emoji/releases/download/v2026-09-24-unicode18_0/Noto-3D-Emoji-Fonts.zip
# but would bloat the package immensely.
# Also, according to the readme, the original black-and-white font has
# resumed development, and can be downloaded from:
# https://fonts.google.com/noto/specimen/Noto+Emoji
# but there is no versioned distfile.
MODFONT_FONTFILES =	2D/fonts/NotoColorEmoji.ttf

.include <bsd.port.mk>
