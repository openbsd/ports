No strchrnul(3) in OpenBSD.

Index: src/basic/string-util.h
--- src/basic/string-util.h.orig
+++ src/basic/string-util.h
@@ -12,6 +12,15 @@
 
 #include "macro.h"
 
+#ifdef __OpenBSD__
+static inline char *basu_strchrnul(const char *s, int c) {
+        char *p = strchr(s, c);
+
+        return p ? p : (char *) s + strlen(s);
+}
+#define strchrnul basu_strchrnul
+#endif
+
