 static int bus_socket_write_null_byte(sd_bus *b) {
+#if defined(__OpenBSD__)
+        /* There is no way to pass credentials as ancillary data on
+         * OpenBSD: send a bare NUL byte, the peer gets our credentials
+         * with getsockopt(SO_PEERCRED). This is what libdbus does on OpenBSD
+         * (write_credentials_byte() and _dbus_read_credentials_socket()). */
+        struct iovec iov = {
+                .iov_base = (void*) "\0",
+                .iov_len = 1,
+        };
+        struct msghdr mh;
+        zero(mh);
+
+        mh.msg_iov = &iov;
+        mh.msg_iovlen = 1;
+
+        int k = sendmsg(b->output_fd, &mh, MSG_DONTWAIT|MSG_NOSIGNAL);
+        if (k < 0)
+                return errno == EAGAIN ? 0 : -errno;
+        b->send_null_byte = false;
+        return 1;
+#else
