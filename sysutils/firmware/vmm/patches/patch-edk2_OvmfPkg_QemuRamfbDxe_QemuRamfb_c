+STATIC
+VOID
+QemuRamfbConfigureMode (
+  VOID
+  )
+{
+  VMD_DISPLAY_CONFIG   Config;
+  FIRMWARE_CONFIG_ITEM Item;
+  EFI_STATUS           Status;
+  UINTN                FwCfgSize;
+  UINT32               Version;
+  UINT32               Width;
+  UINT32               Height;
+
+  Status = QemuFwCfgFindFile (
+             VMD_DISPLAY_CONFIG_FILE,
+             &Item,
+             &FwCfgSize
+             );
+  if (EFI_ERROR (Status)) {
+    return;
+  }
+
+  if (FwCfgSize != sizeof (Config)) {
+    DEBUG ((
+      DEBUG_WARN,
+      "Ramfb: vmd display config size mismatch (expected %lu, got %lu)\n",
+      (UINT64)sizeof (Config),
+      (UINT64)FwCfgSize
+      ));
+    return;
+  }
+
+  QemuFwCfgSelectItem (Item);
+  QemuFwCfgReadBytes (sizeof (Config), &Config);
+  Version = SwapBytes32 (Config.Version);
+  Width   = SwapBytes32 (Config.Width);
+  Height  = SwapBytes32 (Config.Height);
+  if ((Version != VMD_DISPLAY_CONFIG_VERSION) ||
+      (Width < VMD_DISPLAY_MIN_WIDTH) ||
+      (Width > VMD_DISPLAY_MAX_WIDTH) ||
+      (Height < VMD_DISPLAY_MIN_HEIGHT) ||
+      (Height > VMD_DISPLAY_MAX_HEIGHT))
+  {
+    DEBUG ((
+      DEBUG_WARN,
+      "Ramfb: ignoring invalid vmd display config v%u %ux%u\n",
+      Version,
+      Width,
+      Height
+      ));
+    return;
+  }
+
+  mQemuRamfbModeInfo[0].HorizontalResolution = Width;
+  mQemuRamfbModeInfo[0].VerticalResolution   = Height;
+}
+
 EFI_STATUS
 EFIAPI
 InitializeQemuRamfb (
