Use the SerialDxe console alongside the normal graphical console for vmd.
vmd already supplies each device's PCI interrupt line; enable ACPI at its
PM1A control port without writing QEMU PIIX or Q35 routing registers.

Index: edk2/OvmfPkg/Library/PlatformBootManagerLib/BdsPlatform.c
--- edk2/OvmfPkg/Library/PlatformBootManagerLib/BdsPlatform.c.orig
+++ edk2/OvmfPkg/Library/PlatformBootManagerLib/BdsPlatform.c
@@ -222,10 +222,18 @@ PlatformBootManagerBeforeConsole (
   UINT16         FrontPageTimeout;
   RETURN_STATUS  PcdStatus;
   BOOLEAN        FirmwareSetupEnabled;
+  BOOLEAN        SerialConsole;
+  BOOLEAN        VmdHost;
 
   DEBUG ((DEBUG_INFO, "PlatformBootManagerBeforeConsole\n"));
   InstallDevicePathCallback ();
 
+  VmdHost = (PcdGet16 (PcdOvmfHostBridgePciDevId) ==
+             VMD_HOSTBRIDGE_DEVICE_ID);
+  SerialConsole = XenDetected () || VmdHost ||
+                  (PcdGet16 (PcdOvmfHostBridgePciDevId) ==
+                   CLOUDHV_DEVICE_ID);
+
   VisitAllInstancesOfProtocol (
     &gEfiPciRootBridgeIoProtocolGuid,
     ConnectRootBridge,
@@ -258,13 +266,15 @@ PlatformBootManagerBeforeConsole (
   // We need to connect all trusted consoles for TCG PP. Here we treat all
